{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES6", "ES2020"],

    "module": "CommonJS",

    "resolveJsonModule": true,
    "moduleResolution": "Node",

    "allowJs": true,

    "outDir": "./out",

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    "skipLibCheck": true
  },
  "include": ["test/jest-setup.ts"],
  "exclude": ["node_modules"]
}
